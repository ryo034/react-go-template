{
  "name": "system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && rm -rf dist/**/*.js.map",
    "build-analyze": "tsc && vite build --mode analyze && rm -rf dist/**/*.js.map",
    "ci": "biome ci ./",
    "lint": "biome check --apply-unsafe ./",
    "lint:fix": "biome check --apply ./",
    "lint:fix-unsafe": "biome check --apply-unsafe ./",
    "format": "biome format ./",
    "preview": "vite preview",
    "test": "vitest run --reporter verbose",
    "test-m": "vitest run --reporter verbose ./test/components/onboarding/name/form.test.tsx",
    "test-coverage": "vitest run --reporter verbose --coverage",
    "test-components": "vitest run ./test/components/library/reference/create/form.test.tsx --reporter verbose",
    "test-watch-components": "vitest ./test/components --reporter verbose"
  },
